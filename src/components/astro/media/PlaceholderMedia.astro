---
import { resolveAsset } from '@utils/resolveAssets';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="placeholder-media" role="img" aria-label={label}>
  <!-- <img src={resolveAsset(src)} alt={label} class="article-thumbnail" /> -->
  <span>{label}</span>
</div>

<style>
  .placeholder-media {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 140px;
    border: 1px dashed var(--color-border);
    background: repeating-linear-gradient(
      45deg,
      #f4f4f4,
      #f4f4f4 8px,
      #ececec 8px,
      #ececec 16px
    );
    color: var(--color-text-muted);
    text-align: center;
    padding: 1rem;
    box-sizing: border-box;
  }

  span {
    font-size: 0.8rem;
    line-height: 1.4;
    max-width: 16rem;
  }
</style>
