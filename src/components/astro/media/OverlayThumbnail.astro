---
import { resolveAsset } from '@utils/resolveAssets';

interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<img src={resolveAsset(src)} alt={alt} class="overlay-thumbnail" />

<style>
  .overlay-thumbnail {
    display: block;
    height: 20vw;
    width: auto;
    /* max-height: 160px; */
    object-fit: contain;
  }
</style>
