---
import { resolveAsset } from '@utils/resolveAssets';

interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<img src={resolveAsset(src)} alt={alt} class="hero-thumbnail" />

<style>
  .hero-thumbnail {
    display: block;
    width: 60%;
    height: auto;
    max-height: 160px;
    object-fit: contain;
  }
</style>
