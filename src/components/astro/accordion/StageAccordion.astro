---
import CategoryCard from '../cards/CategoryCard.astro';
import type { PathSection } from '@contents/ui/article-paths';

interface Props {
  sections: PathSection[];
  openId?: string;
}

const { sections, openId = '' } = Astro.props;
---

<div class="accordion" data-accordion>
  {sections.map((section: PathSection[]) => (
    <details class="accordion__item" open={section.id === openId}>
      <summary>
        <span>{section.title}</span>
        <span class="chevron" aria-hidden="true"></span>
      </summary>
      <div class="accordion__body">
        {section.groups.map((group) => (
          <div class="topic-group">
            {group.title && <h3>{group.title}</h3>}
            <div class="topic-grid">
              {group.cards.map((card, index) => (
                <CategoryCard
                  href=`/patient-space/${card.href}`
                  label={card.label}
                  iconLabel={card.iconLabel}
                  selected={section.id === 'stage-1' && index === group.cards.length - 1}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    </details>
  ))}
</div>

<script>
  const root = document.querySelector('[data-accordion]');
  root?.querySelectorAll('details').forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;
      root.querySelectorAll('details').forEach((other) => {
        if (other !== item) other.removeAttribute('open');
      });
    });
  });
</script>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .accordion__item {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    cursor: pointer;
    list-style: none;
    text-transform: uppercase;
    font-weight: 400;
    font-size: 0.8rem;
    font-style: light;
    letter-spacing: 0.03em;
    opacity:0.8;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .accordion__item[open] summary {
    background: #eef0f5;
  }

  .chevron {
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }

  .accordion__item[open] .chevron {
    transform: rotate(45deg);
  }

  .accordion__body {
    padding: 0.5rem 1.2rem 1.4rem;
  }

  h3 {
    margin: 1rem 0 0.7rem;
    font-size: 1rem;
    font-style: italic;
    font-weight: 600;
    color: var(--color-group-label);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.85rem;
  }
</style>
