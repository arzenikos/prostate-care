---
import LineIcon from '@components/astro/ui/LineIcon.astro';
import { landing } from '@contents/ui/site';

---
<!-- Unused -->
<button class="ai-prompt" type="button" data-open-chat>
    <LineIcon name="robot" />
    <span>{landing.aiPrompt}</span>
</button>



<style>
    .ai-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    font-style: italic;
    cursor: pointer;
  }
</style>