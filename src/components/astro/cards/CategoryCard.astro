---
import ArticleThumbnail from '@components/astro/media/ArticleThumbnail.astro';

interface Props {
  href: string;
  label: string;
  iconLabel: string;
  selected?: boolean;
}

const { href, label, iconLabel, selected = false } = Astro.props;
---

<a class="category-card" href={href}>
  <ArticleThumbnail src="placeholders/placeholder-cards.png" alt={iconLabel} />
  <span>{label}</span>
</a>

<style>
  .category-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    min-height: 170px;
    padding: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-navy);
  }

  .category-card :global(.placeholder-media) {
    min-height: 88px;
    border: 0;
    background: transparent;
  }

  span {
    display: block;
    margin-top: 0.6rem;
    font-size: 1.2rem;
    line-height: 1.35;
  }
  .category-card:hover {
    border-color: var(--color-navy);
    background: var(--color-card-selected);
  }
</style>
