---
import PersonaThumbnail from '@components/astro/media/PersonaThumbnail.astro';

interface Props {
  href: string;
  title: string;
  body: string;
  thumbnail: string;
  label: string;
}

const { href, title, body, thumbnail, label } = Astro.props;
---

<a class="path-card" href={href}>
  <PersonaThumbnail src={thumbnail} alt={label} />
  <h2>{title}</h2>
  <p>{body}</p>
</a>

<style>
  .path-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 340px;
    padding: 1.6rem 3rem;
    text-align: center;
    background: var(--color-card);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: var(--color-navy);
    box-sizing: border-box;
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.35;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .path-card:hover {
    transform: translateY(-2px);
  }
</style>
