---
// import PersonaThumbnail from '@components/astro/media/PersonaThumbnail.astro';
import { resolveAsset } from '@utils/resolveAssets';

interface Props {
  href: string;
  title: string;
  body: string;
  thumbnail: string;
  label: string;
}

const { href, title, body, thumbnail, label } = Astro.props;
---

<a class="path-card" href={href}>
  <div class="path-card__thumbnail">
    <img src={resolveAsset(thumbnail)} alt={label} class="persona-thumbnail" />
  </div>

  <div class="path-card__content">
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
</a>

<style>
  .path-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 50%;
    width: 85%;
    margin: 4.5em auto 0em auto;
    text-align: center;
    justify-content: center;
    text-decoration: none;
    color: var(--color-navy);
    overflow: visible;
  }

  .path-card__thumbnail img {
    position: absolute;
    top: -65%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    height: 100%; /* scales with card width */
  }

  .path-card__content {
    background: var(--color-card);
    border-radius: var(--radius-card);
    position: relative;
    padding: 6rem 2rem 3rem 2rem;
    z-index: 1;
    box-sizing: border-box;
  }

  h2 {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.35;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .path-card {
    transform: translateY(-2px);
  }

  /* Responsive adjustments */
@media (max-width: 600px) {
  .path-card__thumbnail img {
    top: -55%;
    width: 40%;
  }
  .path-card {
    padding: 1.5rem 1rem;
  }
}
</style>
