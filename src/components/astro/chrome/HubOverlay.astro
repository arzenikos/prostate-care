---
import LineIcon from '@components/astro/ui/LineIcon.astro';
import OverlayThumbnail from '@components/astro/media/OverlayThumbnail.astro';

import { overlays } from '@contents/ui/site';
---

<div class="hub-root" data-hub-root hidden>
  {Object.values(overlays).map((panel) => (
    <section
      id={`hub-overlay-${panel.id}`}
      class="hub-overlay"
      data-overlay-panel={panel.id}
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby={`hub-heading-${panel.id}`}
    >
      <button class="hub-overlay__close" type="button" data-overlay-close aria-label="Close overlay">
        <LineIcon name="close" />
      </button>
      <div class="hub-overlay__main">
        <div class="hub-overlay__art">
          <OverlayThumbnail src="hero/hero-left-clear.png" alt="overlay mandala"/>
        
        </div>
        <div class="hub-overlay__copy">
          <h2 id={`hub-heading-${panel.id}`}>{panel.heading}</h2>
          <p>{panel.body}</p>

          {panel.id === 'newsletter' && (
            <form class="hub-form" action="/newsletters" method="get">
              <label class="sr-only" for="newsletter-email">Email address</label>
              <input id="newsletter-email" name="email" type="email" placeholder="email@example.com" required />
              <button type="submit" aria-label="Subscribe">
                <LineIcon name="send" />
              </button>
            </form>
          )}

          {'footerLink' in panel && panel.footerLink && (
            <a class="hub-overlay__cta" href={panel.footerLink.href}>
              {panel.footerLink.label}
              <LineIcon name="chevron" size={18} />
            </a>
          )}
        </div>
      </div>
    </section>
  ))}
</div>

<script>
  const root = document.querySelector('[data-hub-root]');
  const buttons = document.querySelectorAll('[data-overlay]');
  const panels = document.querySelectorAll('[data-overlay-panel]');
  let hasScrolledAway = false;

  const scrollToTop = () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }
  const closeAll = () => {
    root?.setAttribute('hidden', '');
    panels.forEach((panel) => panel.setAttribute('hidden', ''));
    buttons.forEach((button) => {
      button.classList.remove('is-active');
      button.setAttribute('aria-expanded', 'false');
    });
  };

  const openPanel = (id: string) => {
    const panel = document.querySelector(`[data-overlay-panel="${id}"]`);
    if (!panel || !root) return;
    const alreadyOpen = !panel.hasAttribute('hidden');
    closeAll();
    if (alreadyOpen) return;
    root.removeAttribute('hidden');
    panel.removeAttribute('hidden');
    document.querySelector(`[data-overlay="${id}"]`)?.classList.add('is-active');
    document.querySelector(`[data-overlay="${id}"]`)?.setAttribute('aria-expanded', 'true');
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      scrollToTop();
      const id = button.getAttribute('data-overlay');
      if (id) openPanel(id);
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10 && !hasScrolledAway) {
      closeAll(); // close all overlays
      hasScrolledAway = true;

    } else if (window.scrollY <= 10 && hasScrolledAway) {
      hasScrolledAway = false; // reset if they scroll back to top
    }
  });
  document.querySelectorAll('[data-overlay-close]').forEach((button) => {
    button.addEventListener('click', closeAll);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });

  document.querySelectorAll('[data-font-size]').forEach((button) => {
    button.addEventListener('click', () => {
      const size = button.getAttribute('data-font-size') || 'base';
      document.documentElement.classList.remove('text-sm', 'text-base', 'text-xl');
      document.documentElement.classList.add(`text-${size}`);
      localStorage.setItem('pamana-font', size);
    });
  });

  document.querySelector('[data-contrast-toggle]')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('high-contrast');
    localStorage.setItem('pamana-contrast', document.documentElement.classList.contains('high-contrast') ? 'on' : 'off');
  });

  const savedFont = localStorage.getItem('pamana-font');
  if (savedFont) {
    document.documentElement.classList.add(`text-${savedFont}`);
  }
  if (localStorage.getItem('pamana-contrast') === 'on') {
    document.documentElement.classList.add('high-contrast');
  }

  // window.addEventListener('scroll', closeAll);



</script>

<style>
  .hub-root:not([hidden]) {
    display: block;
    /* max-width: var(--content-width); */
    max-height: var(--content-height);
    /* margin: 0 auto; */
    /* padding: 0 1.5rem 1.5rem; */
    /* Float */
    position: relative;        /* stays on screen */
    inset: 0;               /* top:0 right:0 bottom:0 left:0 */
    background: rgba(0, 0, 0, 0.5); /* dimmed backdrop */
    /* display: flex; */
    /* align-items: center; */
    /* justify-content: center; */
    z-index: 999;           /* above everything */
    padding: 0 0 1.5rem;
    overflow-y: auto;
    
  }

  .hub-overlay {
    position: relative; /* this is fine */
    /* margin: 4rem auto; */
    /* max-width: 900px; */
    background: var(--color-navy);
    color: #fff;
    /* padding: 2.5rem 2rem 2rem; */
    /* border-radius: 12px; */
  }

  .hub-overlay[hidden] {
    display: none;
  }

  .hub-overlay__art {
    display: flex;
    overflow-y: hidden;
    /* align-items: center; */
  }

  .hub-overlay__art :global(.placeholder-media) {
    min-height: 300px;
    color: #fff;
    min-width: 300px;
    /* max-width: var(--content-width); */
  }

  .hub-overlay__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .hub-overlay__main {
    display: flex;
    /* gap: 2; */
    /* justify-content: space-between; */
  }

  .hub-overlay__copy {
    max-width: 50rem;
    margin: 1em 2em;
  }

  h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: #fff;
  }

  p {
    margin: 0 0 1.2rem;
    font-size: clamp(1rem, 2vw, 1.8rem);
    color: #fff;
    line-height: 1.55;
  }

  .hub-form {
    display: flex;
    max-width: 28rem;
    background: #fff;
  }

  .hub-form input {
    flex: 1;
    border: 0;
    padding: 0.85rem 1rem;
    font-size: 1rem;
  }

  .hub-form button {
    width: 52px;
    border: 0;
    background: #111;
    color: #fff;
    cursor: pointer;
  }

  .hub-overlay__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .a11y-controls p {
    margin-bottom: 0.4rem;
  }

  .a11y-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .a11y-row button,
  .contrast-btn {
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
  }

  .a11y-row button:nth-child(1) { font-size: 0.8rem; }
  .a11y-row button:nth-child(2) { font-size: 1rem; }
  .a11y-row button:nth-child(3) { font-size: 1.25rem; }

  @media (max-width: 800px) {
    .hub-overlay {
      grid-template-columns: 1fr;
    }
  }
</style>