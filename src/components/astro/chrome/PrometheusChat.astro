---
// Owns: layout, chrome, the collapsed/expanded toggle, backdrop, focus
// return on close. All handled with a plain <script> — no React needed
// for this, per the "React only for genuinely stateful UI" rule.
//
// Delegates to PrometheusChatContent.tsx (React island) for anything
// that needs real state: the input, the streaming fetch, the answer
// body, and the sources card.

import PrometheusChatContent from "@components/react/PrometheusChatContent";

export interface Props {
  persona?: "patient" | "whanau" | "researcher";
}

const { persona = "patient" } = Astro.props;
---



<div id="prometheus-toggle-container" class="prometheus-toggle-container">
  <button id="prometheus-toggle" type="button" aria-label="Open Ask Prometheus AI">
    <!-- <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="var(--color-navy)" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.50"><rect width="20" height="14" x="2" y="9" rx="4"/><circle cx="12" cy="3" r="2"/><circle cx="9" cy="16" r=".5"/><circle cx="15" cy="16" r=".5"/><path d="M12 9V5"/></g></svg> -->
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="var(--color-navy-contrast)" d="M13.5 2c0 .444-.193.843-.5 1.118V5h5a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h5V3.118A1.5 1.5 0 1 1 13.5 2M0 10h2v6H0zm24 0h-2v6h2zM9 14.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3m7.5-1.5a1.5 1.5 0 1 0-3 0a1.5 1.5 0 0 0 3 0"/></svg>
    <!-- <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="var(--color-navy)" d="M13.5 2c0 .444-.193.843-.5 1.118V5h5a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h5V3.118A1.5 1.5 0 1 1 13.5 2M0 10h2v6H0zm24 0h-2v6h2zM9 14.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3m7.5-1.5a1.5 1.5 0 1 0-3 0a1.5 1.5 0 0 0 3 0"/></svg> -->
  </button>
</div>

<div id="prometheus-backdrop" class="prometheus-backdrop">
  <div
    id="prometheus-panel"
    class="prometheus-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Ask Prometheus AI"
  >
    <!-- Top bar -->
    <div class="prometheus-topbar">
      <button id="prometheus-collapse" type="button" class="prometheus-icon-btn" aria-label="Collapse">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="#f4f1ea" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.50" d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <button id="prometheus-expand" type="button" class="prometheus-icon-btn" aria-label="Expand to full screen">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4F1EA" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <!-- Identity — fully static, no interactivity needed -->
    <div class="prometheus-identity">
      <div class="prometheus-icon-circle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8B93F8" stroke-width="2">
          <rect x="3" y="8" width="18" height="12" rx="2" />
          <circle cx="8.5" cy="14" r="1.2" fill="#8B93F8" />
          <circle cx="15.5" cy="14" r="1.2" fill="#8B93F8" />
          <path d="M12 8V4M9 4h6" stroke-linecap="round" />
        </svg>
      </div>
      <p class="prometheus-title">
        Ask Prometheus AI
      </p>
    </div>

    <!-- Everything below needs real state: mounted as a React island -->
    <PrometheusChatContent client:load persona={persona} />
  </div>
</div>

<script>
  const toggleContainer = document.getElementById("prometheus-toggle-container");
  const toggle = document.getElementById("prometheus-toggle");
  const backdrop = document.getElementById("prometheus-backdrop");
  const panel = document.getElementById("prometheus-panel");
  const collapse = document.getElementById("prometheus-collapse");

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function openPanel() {
    backdrop?.classList.add("is-open");
    toggleContainer?.classList.add("is-hidden");
    document.body.style.overflow = "hidden";

    // slideUpBigIn: fade in while sliding up 75px
    if (!reduceMotion.matches) {
      panel?.animate(
        [
          { opacity: 0, transform: "translateY(75px)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: 800, easing: "cubic-bezier(0.215, 0.61, 0.355, 1)", fill: "backwards" }
      );
    }

    window.dispatchEvent(new CustomEvent("prometheus:opened"));
  }

  function closePanel() {
    backdrop?.classList.remove("is-open");
    toggleContainer?.classList.remove("is-hidden");
    document.body.style.overflow = "";
    // lets the island clear its answer/sources so reopening starts fresh
    window.dispatchEvent(new CustomEvent("prometheus:closed"));
    toggle?.focus();
  }

  toggle?.addEventListener("click", openPanel);
  collapse?.addEventListener("click", closePanel);

  backdrop?.addEventListener("click", (e) => {
    if (e.target === backdrop) closePanel();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && backdrop?.classList.contains("is-open")) closePanel();
  });
</script>

<style>
  /* Launcher button */
  .prometheus-toggle-container {
    position: fixed;
    right: 2rem;
    bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    z-index: 50;
  }

  .prometheus-toggle-container.is-hidden {
    display: none;
  }

  /* Backdrop */
  .prometheus-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    align-items: flex-start;
    justify-content: center;
    padding-top: 4rem;
    padding-left: 1rem;
    padding-right: 1rem;
    background: #0a0b148c;
  }

  .prometheus-backdrop.is-open {
    display: flex;
  }

  /* Panel */
  .prometheus-panel {
    position: fixed;
    bottom: -2rem;
    width: 80%;
    height: 40%;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    background: #171a2e;
    border: 1px solid rgba(226, 224, 216, 0.12);
    padding: 3rem 4rem;
  }

  /* Top bar */
  .prometheus-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* padding: 2rem 1.25rem 0; */
  }

  .prometheus-icon-btn {
    opacity: 0.5;
    transition: opacity 0.15s ease;
  }

  .prometheus-icon-btn:hover {
    opacity: 0.9;
  }

  /* Identity block */
  .prometheus-identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0 1.25rem;
  }

  .prometheus-icon-circle {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* background: #101226; */
    /* border: 1px solid #e2e0d81f; */
  }

  .prometheus-title {
    font-style: italic;
    font-size: 15px;
    color: #F4F1EA;
    font-family: Georgia, serif;
  }

  .prometheus-toggle-container button {
    background: var(--color-navy-contrast);
    background: var(--color-navy);
    padding: 1rem;
    z-index: 50;
    border-radius: 20%;
  }

  .prometheus-topbar button {
    /* position: relative; */
    /* padding: 2cap; */
    /* z-index: 50; */
  }
</style>