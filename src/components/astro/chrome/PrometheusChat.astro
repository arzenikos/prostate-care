---
// Owns: layout, chrome, the collapsed/expanded toggle, backdrop, focus
// return on close. All handled with a plain <script> — no React needed
// for this, per the "React only for genuinely stateful UI" rule.
//
// Delegates to PrometheusChatContent.tsx (React island) for anything
// that needs real state: the input, the streaming fetch, the answer
// body, and the sources card.

import PrometheusChatContent from "@components/react/PrometheusChatContent";

export interface Props {
  persona?: "patient" | "whanau" | "researcher";
}

const { persona = "patient" } = Astro.props;
---

<button
  id="prometheus-toggle"
  aria-label="Open Ask Prometheus AI"
  class="prometheus-toggle fixed left-1/2 bottom-40 -translate-x-1/2 flex flex-col items-center gap-1 group"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32"><path fill="black" d="M30.47 18.28V7.62h-1.52v9.14h-1.52v-1.52H25.9v12.19h1.53V25.9h3.04v-1.52H32v-6.1zm-6.09-6.09h1.52v3.05h-1.52ZM6.09 27.43v1.52h1.53v1.53h1.52v-1.53h13.71v1.53h1.53v-1.53h1.52v-1.52zm16.76-9.15h1.53v3.05h-1.53Zm0-7.61h1.53v1.52h-1.53Zm-3.04 6.09h3.04v1.52h-3.04ZM9.14 30.48h13.71V32H9.14Zm10.67-9.15h3.04v1.53h-3.04Zm-1.53-3.05h1.53v3.05h-1.53Zm0-16.76h1.53v1.53h-1.53Zm-4.57 22.86h4.57v1.52h-4.57Zm0-24.38h4.57v1.52h-4.57Zm-1.52 18.28h1.52v3.05h-1.52Zm0-16.76h1.52v1.53h-1.52ZM9.14 16.76h3.05v1.52H9.14Zm13.71-6.09V9.14h-6.09V4.57h1.52V3.05h-4.57v1.52h1.52v4.57H9.14v1.53z"/><path fill="black" d="M9.14 21.33h3.05v1.53H9.14Zm-1.52-3.05h1.52v3.05H7.62Zm0-7.61h1.52v1.52H7.62Zm-1.53 1.52h1.53v3.05H6.09Zm0 3.05H4.57v1.52H3.04V7.62H1.52v10.66H0v6.1h1.52v1.52h3.05v1.53h1.52z"/></svg>
</button>

<div
  id="prometheus-backdrop"
  class="hidden fixed inset-0 z-50 items-start justify-center pt-16 px-1"
  style="background: rgba(10,11,20,0.55)"
>
  <div
    id="prometheus-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Ask Prometheus AI"
    class="fixed center bottom-30 w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden"
    style="background:#171a2e;border:1px solid rgba(226,224,216,0.12)"
  >
    <!-- Top bar -->
    <div class="flex items-center justify-between px-5 pt-4">
      <button id="prometheus-collapse" aria-label="Collapse" class="opacity-50 hover:opacity-90 transition-opacity">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4F1EA" stroke-width="2">
          <path d="M18 15l-6-6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <!-- <button id="prometheus-expand" aria-label="Expand to full screen" class="opacity-50 hover:opacity-90 transition-opacity">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4F1EA" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button> -->
    </div>

    <!-- Identity — fully static, no interactivity needed -->
    <div class="flex flex-col items-center gap-2 pt-2 pb-5">
      <div class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#101226;border:1px solid rgba(226,224,216,0.12)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8B93F8" stroke-width="2">
          <rect x="3" y="8" width="18" height="12" rx="2" />
          <circle cx="8.5" cy="14" r="1.2" fill="#8B93F8" />
          <circle cx="15.5" cy="14" r="1.2" fill="#8B93F8" />
          <path d="M12 8V4M9 4h6" stroke-linecap="round" />
        </svg>
      </div>
      <p class="italic text-[15px]" style="color:#F4F1EA;font-family:Georgia, serif">
        Ask Prometheus AI
      </p>
    </div>

    <!-- Everything below needs real state: mounted as a React island -->
    <PrometheusChatContent client:load persona={persona} />
  </div>
</div>

<script>
  const toggle = document.getElementById("prometheus-toggle");
  const backdrop = document.getElementById("prometheus-backdrop");
  const collapse = document.getElementById("prometheus-collapse");

  function openPanel() {
    backdrop?.classList.remove("hidden");
    backdrop?.classList.add("flex");
    toggle?.classList.add("hidden");
    document.body.style.overflow = "hidden";
    window.dispatchEvent(new CustomEvent("prometheus:opened"));
  }

  function closePanel() {
    backdrop?.classList.add("hidden");
    backdrop?.classList.remove("flex");
    toggle?.classList.remove("hidden");
    document.body.style.overflow = "";
    // lets the island clear its answer/sources so reopening starts fresh
    window.dispatchEvent(new CustomEvent("prometheus:closed"));
  }

  toggle?.addEventListener("click", openPanel);
  collapse?.addEventListener("click", closePanel);

  backdrop?.addEventListener("click", (e) => {
    if (e.target === backdrop) closePanel();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !backdrop?.classList.contains("hidden")) closePanel();
  });
</script>

<style>
  # prometheus-toggle {
    border: 1px solid #101226;
  }

  button {
    background: #334df689;
    padding: 4rem;
    z-index: 50;
    border-radius: 50%;
  }

  #prometheus-collapse {
    background: #334df624;
    padding: 0.5rem;
    border-radius: 50%;
  }
</style>