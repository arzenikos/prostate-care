---
// Owns: layout, chrome, the collapsed/expanded toggle, backdrop, focus
// return on close. All handled with a plain <script> — no React needed
// for this, per the "React only for genuinely stateful UI" rule.
//
// Delegates to PrometheusChatContent.tsx (React island) for anything
// that needs real state: the input, the streaming fetch, the answer
// body, and the sources card.

import PrometheusChatContent from "@components/react/PrometheusChatContent";

export interface Props {
  persona?: "patient" | "whanau" | "researcher";
}

const { persona = "patient" } = Astro.props;
---



<div id="prometheus-toggle-container" class="prometheus-toggle-container">
  <button id="prometheus-toggle" type="button" aria-label="Open Ask Prometheus AI">
    <!-- <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="var(--color-navy)" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.50"><rect width="20" height="14" x="2" y="9" rx="4"/><circle cx="12" cy="3" r="2"/><circle cx="9" cy="16" r=".5"/><circle cx="15" cy="16" r=".5"/><path d="M12 9V5"/></g></svg> -->
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="var(--color-navy-contrast)" d="M13.5 2c0 .444-.193.843-.5 1.118V5h5a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h5V3.118A1.5 1.5 0 1 1 13.5 2M0 10h2v6H0zm24 0h-2v6h2zM9 14.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3m7.5-1.5a1.5 1.5 0 1 0-3 0a1.5 1.5 0 0 0 3 0"/></svg>
    <!-- <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="var(--color-navy)" d="M13.5 2c0 .444-.193.843-.5 1.118V5h5a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h5V3.118A1.5 1.5 0 1 1 13.5 2M0 10h2v6H0zm24 0h-2v6h2zM9 14.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3m7.5-1.5a1.5 1.5 0 1 0-3 0a1.5 1.5 0 0 0 3 0"/></svg> -->
  </button>
</div>

<div id="prometheus-backdrop" class="prometheus-backdrop">
  <div id="prometheus-panel-shell" class="prometheus-panel-shell">
    <button id="prometheus-rise" type="button" class="prometheus-rise" aria-label="Expand chat upward">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path id="prometheus-rise-icon" d="m6 15 6-6 6 6" />
      </svg>
    </button>

    <div
      id="prometheus-panel"
      class="prometheus-panel"
      role="dialog"
      aria-modal="true"
      aria-label="Ask Prometheus AI"
    >
      <!-- Identity — fully static, no interactivity needed -->
      <div class="prometheus-identity">
        <div class="prometheus-icon-circle">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8B93F8" stroke-width="2">
            <rect x="3" y="8" width="18" height="12" rx="2" />
            <circle cx="8.5" cy="14" r="1.2" fill="#8B93F8" />
            <circle cx="15.5" cy="14" r="1.2" fill="#8B93F8" />
            <path d="M12 8V4M9 4h6" stroke-linecap="round" />
          </svg>
        </div>
        <p class="prometheus-title">
          Ask Prometheus AI
        </p>
      </div>

      <!-- Everything below needs real state: mounted as a React island -->
      <PrometheusChatContent client:load persona={persona} />
    </div>
  </div>
</div>

<script>
  const toggleContainer = document.getElementById("prometheus-toggle-container");
  const toggle = document.getElementById("prometheus-toggle");
  const backdrop = document.getElementById("prometheus-backdrop");
  const shell = document.getElementById("prometheus-panel-shell");
  const panel = document.getElementById("prometheus-panel");
  const rise = document.getElementById("prometheus-rise");

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let gestureStartY = 0;
  let gestureStartX = 0;
  let gestureActive = false;
  let isExpanded = false;

  function openPanel() {
    setExpandedState(false);
    backdrop?.classList.add("is-open");
    toggleContainer?.classList.add("is-hidden");
    document.body.style.overflow = "hidden";

    // slideUpBigIn: fade in while sliding up 75px
    if (!reduceMotion.matches) {
      panel?.animate(
        [
          { opacity: 0, transform: "translateY(75px)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: 800, easing: "cubic-bezier(0.215, 0.61, 0.355, 1)", fill: "backwards" }
      );
    }

    window.dispatchEvent(new CustomEvent("prometheus:opened"));
  }

  function closePanel() {
    backdrop?.classList.remove("is-open");
    toggleContainer?.classList.remove("is-hidden");
    shell?.classList.remove("is-tall", "is-lifted", "is-generating");
    setExpandedState(false);
    document.body.style.overflow = "";
    // lets the island clear its answer/sources so reopening starts fresh
    window.dispatchEvent(new CustomEvent("prometheus:closed"));
    toggle?.focus();
  }

  toggle?.addEventListener("click", openPanel);
  function setExpandedState(expanded: boolean) {
    if (!panel || !rise) return;
    isExpanded = expanded;
    shell.classList.toggle("is-tall", expanded);
    shell.classList.toggle("is-lifted", expanded);
    shell.classList.toggle("is-collapsed", !expanded);
    rise.setAttribute("aria-label", expanded ? "Collapse chat panel" : "Expand chat upward");
    rise.setAttribute("aria-expanded", String(expanded));
    document.getElementById("prometheus-rise-icon")?.setAttribute(
      "d",
      expanded ? "m6 9 6 6 6-6" : "m6 15 6-6 6 6",
    );
  }

  rise?.addEventListener("click", () => {
    setExpandedState(!isExpanded);
  });

  rise?.addEventListener("pointerdown", (event) => {
    event.stopPropagation();
  });

  panel?.addEventListener("pointerdown", (event) => {
    if (event.pointerType === "mouse" && event.button !== 0) return;
    if ((event.target as HTMLElement).closest("button, input, a")) return;
    gestureStartY = event.clientY;
    gestureStartX = event.clientX;
    gestureActive = true;
    panel.setPointerCapture?.(event.pointerId);
  });

  panel?.addEventListener("pointerup", (event) => {
    if (!gestureActive) return;
    gestureActive = false;

    const deltaY = event.clientY - gestureStartY;
    const deltaX = event.clientX - gestureStartX;
    if (Math.abs(deltaY) < 60 || Math.abs(deltaY) < Math.abs(deltaX)) return;

    if (deltaY < 0) {
      setExpandedState(true);
    } else {
      closePanel();
    }
  });

  panel?.addEventListener("pointercancel", () => {
    gestureActive = false;
  });

  backdrop?.addEventListener("click", (e) => {
    if (e.target === backdrop) closePanel();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && backdrop?.classList.contains("is-open")) closePanel();
  });

  window.addEventListener("prometheus:generating", () => {
    shell?.classList.add("is-generating");
  });
  window.addEventListener("prometheus:generated", () => {
    shell?.classList.remove("is-generating");
  });
</script>

<style>
  /* Launcher button */
  .prometheus-toggle-container {
    position: fixed;
    right: 2rem;
    bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    z-index: 50;
  }

  .prometheus-toggle-container.is-hidden {
    display: none;
  }

  /* Backdrop */
  .prometheus-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    align-items: flex-start;
    justify-content: center;
    padding-top: 4rem;
    padding-left: 1rem;
    padding-right: 1rem;
    background: color-mix(in srgb, var(--color-navy-deep) 28%, transparent);
    backdrop-filter: blur(2px);
  }

  .prometheus-backdrop.is-open {
    display: flex;
  }

  /* Panel */
  .prometheus-panel-shell {
    position: fixed;
    left: 10%;
    bottom: 0;
    width: 80%;
    height: 30%;
    max-height: calc(100vh - var(--header-height) - 1rem);
    transition: height 0.35s ease;
  }

  .prometheus-panel {
    position: absolute;
    inset: 0;
    border-radius: 1rem 1rem 0 0;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    background: color-mix(in srgb, var(--color-navy-deep) 96%, var(--color-navy) 4%);
    border: 1px solid color-mix(in srgb, var(--color-surface) 14%, transparent);
    padding: 3.5rem 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    touch-action: none;
  }

  .prometheus-panel-shell.is-lifted {
    height: 70%;
  }

  .prometheus-panel-shell.is-generating {
    height: 70%;
  }

  .prometheus-panel-shell.is-tall {
    height: calc(100vh - var(--header-height) - 1rem);
  }

  .prometheus-panel-shell.is-collapsed {
    height: 45% !important;
  }

  /* Top bar */
  .prometheus-rise {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    display: none;
    width: 4rem;
    height: 4rem;
    transform: translate(-50%, -50%);
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-surface) 18%, transparent);
    border-radius: 50%;
    background: var(--color-navy-deep);
    color: var(--color-surface);
    box-shadow: var(--shadow-card);
    cursor: pointer;
  }

  .prometheus-rise {
    display: flex;
  }

  /* Identity block */
  .prometheus-identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0 1.25rem;
  }

  .prometheus-icon-circle {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* background: #101226; */
    /* border: 1px solid #e2e0d81f; */
  }

  .prometheus-title {
    font-style: italic;
    font-size: 15px;
    color: #F4F1EA;
    font-family: Georgia, serif;
  }

  .prometheus-toggle-container button {
    background: var(--color-navy-contrast);
    background: var(--color-navy);
    padding: 1rem;
    z-index: 50;
    border-radius: 20%;
  }

  .prometheus-topbar button {
    /* position: relative; */
    /* padding: 2cap; */
    /* z-index: 50; */
  }
</style>