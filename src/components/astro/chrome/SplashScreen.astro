---
import BrandMark from '@components/astro/brand/BrandMark.astro';
import SiteFooter from '@layouts/SiteFooter.astro';
import { brand } from '@contents/ui/site';

---

<div id="splash-screen" class="splash" role="dialog" aria-label="Pamana splash screen">
  <div class="splash__brand">
    <BrandMark size="lg" href="/" />
    <p class="splash__name">{brand.name}</p>
    <p class="splash__tag">{brand.tagline}</p>
  </div>
  <SiteFooter />
</div>

<script>
  const splash = document.getElementById('splash-screen');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const delay = reduceMotion ? 0 : 100;

  window.setTimeout(() => {
    splash?.classList.add('is-done');
    window.setTimeout(() => splash?.remove(), 450);
  }, delay);
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--color-bg);
  }

  .splash__brand {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.85rem;
  }

  .splash__name {
    margin: 0;
    font-family: var(--font-brand);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--color-navy);
  }

  .splash__tag {
    margin: 0;
    color: var(--color-blue);
    font-size: 1rem;
  }

  .splash.is-done {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
</style>
