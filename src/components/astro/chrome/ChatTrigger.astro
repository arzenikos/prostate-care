---
import LineIcon from '@components/ui/LineIcon.astro';
---

<div class="chat-root">
  <button class="chat-trigger" type="button" aria-expanded="false" aria-controls="prometheus-panel" aria-label="Ask Prometheus AI">
    <LineIcon name="robot" size={26} />
  </button>
  <div id="prometheus-panel" class="chat-panel" hidden>
    <iframe
      title="Prometheus AI"
      src="https://copilotstudio.microsoft.com/environments/Default-ef475ff3-7cd1-4fa3-ba77-f63824f7c37c/bots/cr4d1_prometheus/webchat?__version__=2"
    ></iframe>
  </div>
</div>

<script>
  const trigger = document.querySelector('.chat-trigger');
  const panel = document.querySelector('#prometheus-panel');
  trigger?.addEventListener('click', () => {
    const open = !panel?.hasAttribute('hidden');
    if (open) {
      panel?.setAttribute('hidden', '');
      trigger.setAttribute('aria-expanded', 'false');
    } else {
      panel?.removeAttribute('hidden');
      trigger.setAttribute('aria-expanded', 'true');
    }
  });
</script>

<style>
  .chat-root {
    position: fixed;
    right: 1.4rem;
    bottom: 4.5rem;
    z-index: 45;
  }

  .chat-trigger {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    background: transparent;
    color: #111;
    cursor: pointer;
  }

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: 3.4rem;
    width: min(360px, calc(100vw - 2rem));
    height: 420px;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
