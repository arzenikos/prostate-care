---
// src/components/AccessibilityPanel.astro
//
// Usage: drop <AccessibilityPanel /> once in your shared header/layout,
// next to your other header icons (contact, find-a-clinic, FAQ).
//
// It renders:
//  - a toggle button (the "person in circle" icon) that opens/closes the panel
//  - a slide-out panel with a theme toggle and a font-size slider
//
// State (theme + font scale) is persisted to localStorage and applied to
// <html> as `data-theme` and `--font-scale`, so you can read those anywhere
// in your global CSS.
---

<button
  id="a11y-toggle"
  class="a11y-toggle"
  type="button"
  aria-expanded="false"
  aria-controls="a11y-panel"
  aria-label="Accessibility options"
>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
    <circle cx="12" cy="4.5" r="2.1" />
    <path d="M4 8.5c2.6 1 5.3 1.5 8 1.5s5.4-.5 8-1.5" stroke-linecap="round" />
    <path d="M12 10v4.2M12 14.2 9 21M12 14.2l3 6.8M8.2 12.5 6 17" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<div id="a11y-overlay" class="a11y-overlay" hidden></div>

<aside id="a11y-panel" class="a11y-panel" aria-hidden="true" aria-label="Accessibility settings">
  <div class="a11y-panel-inner">
    <button id="a11y-close" class="a11y-close" type="button" aria-label="Close accessibility options">
      <!-- &times; -->
    </button>

    <button
      id="a11y-theme-toggle"
      class="a11y-theme-toggle"
      type="button"
      role="switch"
      aria-checked="false"
      aria-label="Toggle dark mode"
    >
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" stroke-linecap="round"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"/></svg>
    </button>

    <div class="a11y-font-col" role="group" aria-label="Text size">
      <span class="a11y-font-sample small" aria-hidden="true">A</span>
      <div class="a11y-font-slider-wrap">
        <input
          id="a11y-font-slider"
          class="a11y-font-slider"
          type="range"
          min="0"
          max="3"
          step="1"
          value="0"
          aria-label="Text size"
          aria-valuetext="Default"
        />
      </div>
      <span class="a11y-font-sample large" aria-hidden="true">A</span>
    </div>
  </div>
</aside>

<style>
  /* ---- palette: reuse your existing Pamana tokens if you have them ---- */
  .a11y-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1.5px solid var(--pamana-navy, #1c2340);
    background: transparent;
    color: var(--pamana-navy, #1c2340);
    cursor: pointer;
  }
  .a11y-toggle:hover,
  .a11y-toggle[aria-expanded='true'] {
    background: var(--pamana-navy, #1c2340);
    color: var(--pamana-cream, #fbf1e2);
  }

  .a11y-overlay {
    position: fixed;
    inset: 0;
    /* background: #14141e40; */
    z-index: 40;
  }

  .a11y-panel {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 72px;
    /* background: #2b305006; */
    color: #120d02;
    z-index: 40;
    /* only 56px peeks out past the top edge when closed, instead of the full height */
    transform: translateY(calc(-100% + 10px));
    opacity: 0;
    transition: transform 0.2s ease, opacity 0.7s ease;
    padding: 3em 0em;
  }
  .a11y-panel.is-open {
    transform: translateY(0);
    opacity: 1;
  }
  /* .a11y-panel.is-closing {
    transition: transform 0.99s cubic-bezier(0.4, 0, 1, 1), opacity 0.1s ease-in 0.1s;
  } */
  @media (prefers-reduced-motion: reduce) {
    .a11y-panel {
      transition: none;
    }
  }

  .a11y-panel-inner {
    height: 100%;
    padding: 3.25rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .a11y-close {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    background: none;
    border: none;
    color: inherit;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .a11y-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    /* background: #ffffff14; */
    border: 1px solid #0c050555;
    border-radius: 999px;
    color: inherit;
    cursor: pointer;
    flex-shrink: 0;
  }
  .a11y-theme-toggle .icon-moon {
    display: none;
  }
  .a11y-theme-toggle[aria-checked='true'] .icon-sun {
    display: none;
  }
  .a11y-theme-toggle[aria-checked='true'] .icon-moon {
    display: inline-block;
  }

  .a11y-font-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    gap: 0.75rem;
    min-height: 0;
  }
  .a11y-font-sample.small {
    font-size: 0.8rem;
  }
  .a11y-font-sample.large {
    font-size: 1.4rem;
  }

  /* vertical range slider: fix the track's footprint, then rotate the input */
  .a11y-font-slider-wrap {
    width: 24px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .a11y-font-slider {
    width: 130px;
    height: 24px;
    margin: 0;
    opacity: 0.7;
    /* accent-color: #f4efe4; */
    accent-color: #120d0270;

    transform: rotate(-90deg);
  }

  /* ---- global effects: font scale + dark theme ---- */
  :global(html) {
    font-size: calc(100% * var(--font-scale, 1));
  }
  :global(html[data-theme='dark']) {
    /* Swap these for your real dark-mode tokens */
    color-scheme: dark;
  }
</style>

<script>
  const STORAGE_KEY_THEME = 'pamana-theme';
  const STORAGE_KEY_FONT = 'pamana-font-scale';
  const FONT_SCALES = [1, 1.125, 1.25, 1.4] as const;
  const FONT_LABELS = ['Default', 'Large', 'Larger', 'Largest'];

  const toggleBtn = document.getElementById('a11y-toggle') as HTMLButtonElement;
  const panel = document.getElementById('a11y-panel') as HTMLElement;
  const overlay = document.getElementById('a11y-overlay') as HTMLElement;
  const closeBtn = document.getElementById('a11y-close') as HTMLButtonElement;
  const themeToggle = document.getElementById('a11y-theme-toggle') as HTMLButtonElement;
  const fontSlider = document.getElementById('a11y-font-slider') as HTMLInputElement;

  function openPanel() {
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    overlay.hidden = false;
    toggleBtn.setAttribute('aria-expanded', 'true');
    closeBtn.focus();
    document.addEventListener('keydown', onKeydown);
  }

  function closePanel() {
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    overlay.hidden = true;
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.focus();
    document.removeEventListener('keydown', onKeydown);
  }

  function onKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') closePanel();
  }

  toggleBtn.addEventListener('click', () => {
    const isOpen = panel.classList.contains('is-open');
    isOpen ? closePanel() : openPanel();
  });
//   closeBtn.addEventListener('click', closePanel);
  overlay.addEventListener('click', closePanel);

  function applyTheme(isDark: boolean) {
    document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
    themeToggle.setAttribute('aria-checked', String(isDark));
    localStorage.setItem(STORAGE_KEY_THEME, isDark ? 'dark' : 'light');
  }

  themeToggle.addEventListener('click', () => {
    const isDark = themeToggle.getAttribute('aria-checked') !== 'true';
    applyTheme(isDark);
  });

  function applyFontScale(step: number) {
    const scale = FONT_SCALES[step] ?? 1;
    document.documentElement.style.setProperty('--font-scale', String(scale));
    fontSlider.setAttribute('aria-valuetext', FONT_LABELS[step] ?? 'Default');
    localStorage.setItem(STORAGE_KEY_FONT, String(step));
  }

  fontSlider.addEventListener('input', () => {
    applyFontScale(Number(fontSlider.value));
  });

  // ---- restore saved preferences on load ----
  const savedTheme = localStorage.getItem(STORAGE_KEY_THEME);
  applyTheme(savedTheme === 'dark');

  const savedFontStep = Number(localStorage.getItem(STORAGE_KEY_FONT) ?? 0);
  fontSlider.value = String(savedFontStep);
  applyFontScale(savedFontStep);
</script>