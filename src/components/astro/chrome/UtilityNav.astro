---
import LineIcon from '@components/astro/ui/LineIcon.astro';
import AccessibilityPanelOverlay from '@components/astro/chrome/AccessibilityPanelOverlay.astro';

const items = [
  { id: 'newsletter', label: 'Newsletter', icon: 'mail' as const },
  { id: 'clinics', label: 'Find a clinic', icon: 'pin' as const },
  { id: 'node', label: 'Node', icon: 'node' as const },
  // { id: 'accessibility', label: 'Accessibility', icon: 'accessibility' as const },
];
---

<nav class="utility-nav" aria-label="Site utilities">
  {items.map((item) => (
    <button
      type="button"
      class="utility-btn"
      data-overlay={item.id}
      aria-expanded="false"
      aria-controls={`hub-overlay-${item.id}`}
      aria-label={item.label}
    >
      <LineIcon name={item.icon} />
    </button>
  ))}

  <AccessibilityPanelOverlay/>
</nav>

<style>
  .utility-nav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .utility-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-navy);
    cursor: pointer;
  }

  .utility-btn::after {
    content: '';
    position: absolute;
    bottom: -22px;
    top: auto;
    width: 0;
    height: 0;
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    border-bottom: 18px solid var(--color-navy);  flipped: was border-top
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .utility-btn.is-active,
  .utility-btn:hover {
    color: var(--color-overlay);
  }

  .utility-btn.is-active::after {
    opacity: 1;
  }

</style>