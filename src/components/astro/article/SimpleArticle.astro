---
import ArticleLayout from '@layouts/ArticleLayout.astro';
import type { HubId } from '@contents/ui/site';

interface Props {
  title: string;
  heading: string;
  parentLabel?: string;
  parentHref?: string;
  hub?: HubId;
  illustration?: string;
  toc?: { id: string; label: string }[];
}

const {
  title,
  heading,
  parentLabel = 'Navigating Your Diagnosis',
  parentHref = '/patient-space',
  hub = 'patient',
  illustration = 'Placeholder: article illustration',
  toc = [],
} = Astro.props;
---

<ArticleLayout
  title={title}
  heading={heading}
  hub={hub}
  illustration={illustration}
  toc={toc}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: parentLabel, href: parentHref },
    { label: heading },
  ]}
>
  <slot />
</ArticleLayout>
