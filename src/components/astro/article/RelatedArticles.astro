---
import { getPatientSlug, patientArticleHref, type PatientArticle } from '@library/patient-articles';

interface Props {
  articles: PatientArticle[];
}

const { articles } = Astro.props;
---

{articles.length > 0 && (
  <nav class="related" aria-labelledby="related-heading">
    <h2 id="related-heading">Related articles</h2>
    <ul>
      {articles.map((article) => {
        const slug = getPatientSlug(article);
        return (
          <li>
            <a href={patientArticleHref(slug)}>{article.data.heading ?? article.data.title}</a>
            <p>{article.data.description}</p>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<style>
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  h2 {
    margin: 0 0 0.9rem;
    color: var(--color-navy);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }

  a {
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  p {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
