---
interface Props {
  head: string;
  content: string;
}

const { head, content } = Astro.props;
---

<aside class="callout">
  <strong>{head}</strong>
  <p set:html={content}></p>
</aside>

<style>
  .callout {
    padding: 1rem 1.1rem;
    border-left: 4px solid var(--color-navy);
    background: var(--color-card);
    margin: 0 0 1.4rem;
  }

  strong {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-navy);
  }

  p {
    margin: 0;
  }
</style>
