---
import Layout from '@layouts/Layout.astro';
import SplashScreen from '@components/astro/chrome/SplashScreen.astro';
import BrandMark from '@components/astro/brand/BrandMark.astro';
import PersonaCard from '@components/astro/cards/PersonaCard.astro';
import { brand, landing } from '@contents/ui/site';
---

<Layout title="Pamana | Prostate Cancer Support Website" variant="landing" showChat={true}>
  <SplashScreen />
  <section class="landing">
    <div class="landing__brand">
      <BrandMark size="md" />
      <p class="te-reo">{brand.teReo}</p>
      <h1>{landing.heading}</h1>
      <p class="lead">{landing.instruction}</p>
    </div>
    <div class="landing__paths">
      {landing.paths.map((path) => (
        <PersonaCard
          href={path.href}
          title={path.title}
          body={path.body}
          thumbnail={path.thumbnail}
          label={path.iconLabel}
        />
      ))}
    </div>
    
  </section>
</Layout>

<script>
  document.querySelector('[data-open-chat]')?.addEventListener('click', () => {
    document.querySelector('.chat-trigger')?.dispatchEvent(new Event('click'));
  });
</script>

<style>
  .landing {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0rem 1.5rem 4rem;
    text-align: center;
  }

  .landing__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2rem;
  }

  .te-reo {
    margin: 0;
    color: var(--color-text-subtle);
    font-size: 0.95rem;
  }

  h1 {
    margin: 0.3rem 0 0;
    font-size: clamp(2rem, 2vw, 2.2rem);
    line-height: 1.15;
    color: var(--color-navy);
  }

  .lead {
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1.25rem, 1.8vw, 1.2rem);
    max-width: 50rem;

  }

  .landing__paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    text-align: left;
  }

  
  @media (max-width: 860px) {
    .landing__paths {
      grid-template-columns: 1fr;
    }
  }
</style>
