---
import Layout from '@layouts/Layout.astro';
import PlaceholderMedia from '@components/astro/media/PlaceholderMedia.astro';

const newsArticles = [
  { title: 'New Research Findings', date: '15 June 2026', summary: 'Promising new approaches to treatment and prevention.' },
  { title: 'Community Event Success', date: '28 May 2026', summary: 'A community event brought people together for awareness and support.' },
  { title: 'New Support Resources', date: '10 May 2026', summary: 'New resources to help individuals and families navigate their journey.' },
];
---

<Layout title="News | Pamana">
  <section class="news">
    <h1>Latest news</h1>
    <div class="grid">
      {newsArticles.map((article) => (
        <article>
          <PlaceholderMedia label={`Placeholder: ${article.title} image`} />
          <p>{article.date}</p>
          <h2>{article.title}</h2>
          <p>{article.summary}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .news {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  article {
    border: 1px solid var(--color-border);
    padding: 0.8rem;
  }
</style>
