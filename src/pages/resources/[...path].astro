---
import fs from "node:fs";
import path from "node:path";

const resourceRoot = path.resolve(process.cwd(), "public", "assets", "website-knowledge");
const requestedPath = Astro.params.path;
const relativePath = requestedPath
  ?.split("/")
  .map(segment => decodeURIComponent(segment))
  .join(path.sep);

if (!relativePath || relativePath.includes("..") || !relativePath.toLowerCase().endsWith(".pdf")) {
  return Astro.redirect("/", 404);
}

const pdfPath = path.resolve(resourceRoot, relativePath);
const relativeToRoot = path.relative(resourceRoot, pdfPath);
if (relativeToRoot.startsWith("..") || path.isAbsolute(relativeToRoot) || !fs.existsSync(pdfPath)) {
  return Astro.redirect("/", 404);
}

const pdfUrl = `/assets/website-knowledge/${relativeToRoot
  .split(path.sep)
  .map(segment => encodeURIComponent(segment))
  .join("/")}`;
return Astro.redirect(pdfUrl, 307);
---
