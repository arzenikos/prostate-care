---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
// import { content } from '@contents/articles/patient-space/stage-0/what-you-need-to-know-early.md';
import { content } from '@contents/users/c-stage-0.ts';


const heading = content['stage-0'].heading1.title;
const main = content['stage-0'].heading1.main;
---

<SimpleArticle
  title={`Pamana | ${heading}`}
  heading={heading}
  illustration="Placeholder: prostate health illustration"
  toc={[
    { id: 'overview', label: 'Overview' },
    { id: 'what-it-is', label: 'What it is' },
    { id: 'screening', label: 'Why screening matters' },
    { id: 'psa', label: 'PSA test' },
  ]}
>
  <section id="overview">
    <h2>{main.overview.subheading}</h2>
    <p>{main.overview.body[0]}</p>
    <p>{main.overview.body[1]}</p>
    <!-- <ul>
      {main.overview.body[2].items.map((item) => <li>{item}</li>)}
    </ul> -->
  </section>
  <section id="what-it-is">
    <h2>{main.whatItIs.subheading}</h2>
    {main.whatItIs.main.map((block) =>
      typeof block === 'string' ? <p>{block}</p> : (
        <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
      )
    )}
  </section>
  <section id="screening">
    <h2>{main.screeningMatters.subheading}</h2>
    {main.screeningMatters.main.map((block) =>
      typeof block === 'string' ? <p>{block}</p> : (
        <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
      )
    )}
  </section>
  <section id="psa">
    <h2>{main.psaTest.subheading}</h2>
    {main.psaTest.main.map((block) =>
      typeof block === 'string' ? <p>{block}</p> : (
        <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
      )
    )}
  </section>
</SimpleArticle>
