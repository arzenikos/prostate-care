---
import Layout from '@layouts/Layout.astro';
import HubHero from '@components/hero/HubHero.astro';
import StageAccordion from '@components/accordion/StageAccordion.astro';
import { hubs } from '@contents/ui/site';
import { patientSections } from '@contents/ui/article-paths';

const copy = hubs.patient;
const openId = Astro.url.searchParams.get('stage') ?? '';
---

<Layout title="Patient Support Hub | Pamana" hub="patient">
  <HubHero
    breadcrumbs={copy.breadcrumbs}
    heading={copy.heading}
    intro={copy.intro}
    illustration={copy.illustration}
  />
  <section class="patient-path">
    <h6>{copy.prompt}</h6>
    <StageAccordion sections={patientSections} openId={openId} />
  </section>
</Layout>

<style>
  .patient-path {
    max-width: var(--content-width);
    margin: 2em auto;
    padding: 0 1.5rem 4rem;
  }

  h6 {
    font-weight: 700;
    font-size: small;
    margin: 1em 0;
  }
</style>
