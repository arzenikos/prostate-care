---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
import PlaceholderMedia from '@components/media/PlaceholderMedia.astro';
import { content } from '@contents/users/c-stage-1.ts';

const heading = content['stage-1'].heading1.title;
const main = content['stage-1'].heading1.main;
---

<SimpleArticle
  title={`Pamana | ${heading}`}
  heading={heading}
  illustration="Placeholder: diagnosis illustration"
  toc={[{ id: 'gleason', label: main.Gleason.subheading }]}
>
  <section id="gleason">
    <h2>{main.Gleason.subheading}</h2>
    <p>{main.Gleason.body}</p>
    <PlaceholderMedia label="Placeholder: Gleason score diagram" />
  </section>
</SimpleArticle>
