---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
import { content } from '@contents/users/c-stage-1.ts';

const heading = content['stage-1'].heading2.title;
const items = content['stage-1'].heading2.main.questions.body[0].items;
---

<SimpleArticle
  title={`Pamana | ${heading}`}
  heading={heading}
  illustration="Placeholder: clinic visit illustration"
  toc={[{ id: 'questions', label: 'Questions to ask your doctor' }]}
>
  <section id="questions">
    <h2>Questions to Ask Your Doctor</h2>
    <p><em>Pātai Hei Pātai ki tō Rātā</em></p>
    {items.map(({ en, mi }) => (
      <p><strong>{en}</strong><br />{mi}</p>
    ))}
  </section>
</SimpleArticle>
