---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
import Callout from '@components/ui/Callout.astro';
import { content } from '@contents/users/c-stage-0.ts';

const heading = content['stage-0'].heading3.title;
const main = content['stage-0'].heading3.main;
---

<SimpleArticle
  title={`Pamana | ${heading}`}
  heading={heading}
  illustration="Placeholder: screening illustration"
  toc={[
    { id: 'psa-test', label: 'What is the PSA test?' },
    { id: 'recommended', label: 'Is it recommended?' },
    { id: 'results', label: 'Normal results' },
    { id: 'limits', label: 'Limitations' },
  ]}
>
  <Callout
    head="Important"
    content="Any detectable PSA in a man who has had his prostate removed for cancer is abnormal and must be followed up immediately."
  />
  <section id="psa-test">
    <h2>{main.PSATest.subheading}</h2>
    <p>{main.PSATest.body[0]}</p>
    <p>{main.PSATest.body[1]}</p>
    {main.PSATest.summary.map((line) => <p>{line}</p>)}
  </section>
  <section id="recommended">
    <h2>{main.PSARecom.subheading}</h2>
    <p>{main.PSARecom.body[0]}</p>
    <p>{main.PSARecom.body[1]}</p>
  </section>
  <section id="results">
    <h2>{main.PSAResult.subheading}</h2>
    <p>{main.PSAResult.body[0]}</p>
  </section>
  <section id="limits">
    <h2>{main.PSALimitations.subheading}</h2>
    {main.PSALimitations.body.map((item) => <p>{item}</p>)}
  </section>
</SimpleArticle>
