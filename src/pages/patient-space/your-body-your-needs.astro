---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
import { content } from '@contents/users/c-stage-2.ts';

const heading = content['stage-2'].heading3.title;
const main = content['stage-2'].heading3.main;
---

<SimpleArticle title={`Pamana | ${heading}`} heading={heading}>
  <h2>{main.x.subheading}</h2>
  <p>{main.x.body[0]}</p>
</SimpleArticle>
