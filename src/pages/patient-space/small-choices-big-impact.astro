---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
import PlaceholderMedia from '@components/astro/media/PlaceholderMedia.astro';
import { content } from '@contents/users/c-stage-0.ts';

const heading = content['stage-0'].heading2.title;
const main = content['stage-0'].heading2.main;
---

<SimpleArticle title={`Pamana | ${heading}`} heading={heading} illustration="Placeholder: lifestyle illustration">
  <h2>{main.subheading}</h2>
  <div class="grid">
    {main.items.map((item: any) => (
      <article>
        <PlaceholderMedia label={`Placeholder: ${item.head} image`} />
        <h3>{item.head}</h3>
        <p>{item.content}</p>
      </article>
    ))}
  </div>
</SimpleArticle>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  article {
    border: 1px solid var(--color-border);
    padding: 0.8rem;
  }

  h3 {
    margin: 0.6rem 0 0.3rem;
    color: var(--color-navy);
  }
</style>
