---
import Layout from '@layouts/Layout.astro';

const fileSource: string = "./public/assets/pdf/prostate-care-style-guide-v2.0.pdf"
---

<Layout title="Style Guide | Pamana" hub="patient">
  <div class="pdf-wrapper">
    <iframe
      src=`${fileSource}#toolbar=0&navpanes=0`
      class="pdf-frame"
      title="Document viewer"
    >
    </iframe>

    <div class="controls">
      <button id="zoom-in">＋</button>
      <button id="zoom-out">－</button>
      <a href="/files/my-document.pdf" download>⬇</a>
      <button id="fullscreen">⛶</button>
    </div>
  </div>
</Layout>


<script>
  // Optional: fullscreen toggle
  document.getElementById('fullscreen')?.addEventListener('click', () => {
    const el = document.querySelector('.pdf-wrapper');
    if (!document.fullscreenElement) {
      el?.requestFullscreen();
    } else {
      document.exitFullscreen();
    }
  });
</script>

<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
  }

  .pdf-wrapper {
    position: relative;
    width: 100vw;
    height: 100vh;
  }

  .pdf-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .controls {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    opacity: 0.15;
    transition: opacity 0.25s ease;
    backdrop-filter: blur(4px);
  }

  .pdf-wrapper:hover .controls,
  .controls:focus-within {
    opacity: 1;
  }

  .controls button,
  .controls a {
    background: none;
    border: none;
    color: white;
    font-size: 1.1rem;
    cursor: pointer;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
  }

  .controls button:hover,
  .controls a:hover {
    color: #4da6ff;
  }
</style>
