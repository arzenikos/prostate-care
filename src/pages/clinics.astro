---
import Layout from '@layouts/Layout.astro';

export const blueBeaconClinics = [
  {
    name: "St George's Cancer Care Centre",
    description: "Cancer treatment center in Christchurch",
    thumbnail: "/assets/maps/St.George.jpg",
    address: [
      "131 Leinster Road, Merivale, Christchurch 8014",
      "New Zealand"
    ],
    phone: "03 375 6100",
    link: "https://www.google.com/maps/place/St+George's+Cancer+Care+Centre/@-43.5111819,172.6125393,17z/data=!3m1!4b1!4m7!3m6!1s0x6d318bb2425aaaab:0xd8007d5532f30a29!8m2!3d-43.511182!4d172.6174048!!16s%2Fg%2F11gc3f5h13?entry=ttu&g_ep=EgoyMDI1MDYxNy4wIKXMDSoASAFQAw%3D%3D"
  },
  {
    name: "Oncology",
    description: "Cancer treatment center",
    thumbnail: "/assets/maps/Oncology.jpg",
    address: [
      "2 Riccarton Avenue, Christchurch Central City, Christchurch 8011, New Zealand"
    ],
    phone: "03 364 0020",
    link: "https://www.google.com/maps/dir//2+Riccarton+Avenue,+Christchurch+Central+City,+Christchurch+8011/@-43.5335756,172.542429,12z/data=!4m8!4m7!1m0!1m5!1m1!1s0x6d318a4025c7f4b5:0xfdca8809ff9236c7!2m2!1d172.6248297!2d-43.5336052?entry=ttu&g_ep=EgoyMDI1MDYxNy4wIKXMDSoASAFQAw%3D%3D"
  },

  {
    name: "St George’s Hospital",
    description: "Private hospital | Opens 24 Hours",
    thumbnail: "/assets/maps/St.GeorgeHospital.jpg",
    address: [
      "249 Papanui Road, Strowan, Christchurch 8014, New Zealand"
    ],
    phone: "03 375 6000",
    link: "https://www.google.com/maps?s=web&lqi=Ch9wcm9zdGF0ZSBjYW5jZXIgY2xpbmljcyBuZWFyIG1lSJKC-PrlgICACFotEAAQARACGAIYAxgEIh9wcm9zdGF0ZSBjYW5jZXIgY2xpbmljcyBuZWFyIG1lkgEQcHJpdmF0ZV9ob3NwaXRhbJoBJENoZERTVWhOTUc5blMwVkpRMEZuU1VSdGREaE1Vbk5SUlJBQqoBZRABKhsiF3Byb3N0YXRlIGNhbmNlciBjbGluaWNzKAAyHxABIhtfQ_RnHlxtQcdl3R9lAQxzFqlK_TWkY7S0RZcyIxACIh9wcm9zdGF0ZSBjYW5jZXIgY2xpbmljcyBuZWFyIG1l-gEECHMQJQ&vet=12ahUKEwjMqb6NqYSOAxUwklYBHSZoMc0Q1YkKegQIMBAB..i&cs=1&um=1&ie=UTF-8&fb=1&gl=nz&sa=X&geocode=KWcsw9mzizFtMeCfPYJzpMq5&daddr=249+Papanui+Road,+Strowan,+Christchurch+8014"
  },
];
export const blueBeaconGroups = [
  {
    region: "Canterbury - West Coast",
    name: "Timaru – Relaxation Group",
    description:
      "Our South Canterbury Centre holds a regular Relaxation Group taken by trained instructor Leslie Roy for those who are currently dealing with cancer or have been through a cancer diagnosis.",
    recurrence: "Every Monday from 10am to 11am",
    type: "Recurring",
    location: "",
    link: "", // optional external link
  },
  {
    region: "Canterbury - West Coast",
    name: "Cheviot Support Group – Coffee and Chat",
    description:
      "Open invitation to patients and carers in the Hurunui and other areas who would like a morning out socialising. Next held on 12 July 2024 at the Craft Centre, 15 Seddon Street, Cheviot.",
    recurrence: "Second Wednesday of the month from 10am to 11.30am",
    type: "Recurring",
    location: "Craft Centre, 15 Seddon Street, Cheviot",
    link: "", // optional external link
  },
  {
    region: "Nelson",
    name: "Nelson Support Groups",
    description:
      "Cancer Society Nelson Tasman is dedicated to fostering a compassionate and supportive community while navigating cancer together. Join us in our mission to enhance well-being and provide hope for a brighter future.",
    recurrence: "Click to find Nelson support groups in your area",
    type: "Recurring",
    location: "",
    link: "https://cancernelson.org.nz/support-groups", // or relevant link
  }
];

const breadcrumbItems = [
  { label: 'Blueprint', link: '/blueprint', current: false },
  { label: 'BlueBeacon', link: '/blueprint/bluebeacon', current: true }
];

const {
  heading = "BlueBeacon",
  title = `BlueBeacon | BluePrintNZ`,
  description = ["➤ Locate clinics, support groups, and resources near you for care and community."],
  // main = content['stage-1'].heading2.main,
  // breadcrumb = content['stage-1'].heading2.breadcrumbs
} = Astro.props;
---

<Layout title={title}>
  <div class="container mx-auto px-5 md:px-25 pt-10 pb-25">
    <!-- <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} /> -->
    <h2>Clinics</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-6">
      {blueBeaconClinics.map(({ name, description, thumbnail, address, phone, link }, i) => (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full max-w-sm rounded-xl overflow-hidden shadow-md bg-[var(--color-palette-four)] hover:shadow-lg transition-shadow duration-300 no-underline"
          aria-label={`Open Google Maps for ${name}`}
        >
          <div class="h-40 w-full bg-gray-800">
            <img
              src={thumbnail}
              alt={`Map thumbnail for ${name}`}
              class="w-full h-full object-cover"
            />
          </div>
          {/* <!-- Card content --> */}
          <div class="p-4">
            <h3 class="text-lg font-bold text-[var(--color-palette-one)] mb-1">{name || 'Location Name'}</h3>
            <p class="text-md font-semibold text-[var(--color-palette-two)] mb-1">{description || 'Location Description'}</p>
            <p class="text-sm text-[var(--color-palette-two)] whitespace-pre-line">
              {address.join('\n')}
            </p>
            {phone && (
              <p class="text-sm text-[var(--color-palette-two)] mt-2">📞 {phone}</p>
            )}
          </div>
        </a>
      ))}
    </div>

    <hr class="my-10 border-t border-[var(--color-palette-gray)]" />

    <h2>Support Groups</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-8">
      {blueBeaconGroups.map((group) => (
        <div class="bg-white shadow-md rounded-xl border border-neutral-200 p-6 flex flex-col justify-between hover:shadow-lg transition-all duration-200">
          <div>
            <h3 class="text-sm text-blue-700 font-semibold uppercase tracking-wide mb-1">
              {group.region}
            </h3>
            <h2 class="text-lg font-bold text-neutral-800 mb-2">
              {group.name}
            </h2>
            <p class="text-sm text-neutral-600 mb-3 leading-relaxed">
              {group.description}
            </p>
            {group.location && (
              <p class="text-sm mb-1">
                📍 <span class="font-medium text-[var(--color-palette-four)]">{group.location}</span>
              </p>
            )}
            <p class="text-sm mb-2">
              🗓️ <span class="italic text-[var(--color-palette-four)]">{group.type} — {group.recurrence}</span>
            </p>
          </div>
          {group.link && (
            <a
              href={group.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-blue-600 mt-3 underline hover:text-blue-800 transition"
            >
              Learn more →
            </a>
          )}
        </div>
      ))}
    </div>

    <hr class="my-10 border-t border-[var(--color-palette-gray)]" />
    
    <div class="mt-15 bg-[var(--color-palette-one)] text-[var(--color-palette-five)] p-7 rounded-lg">
      <strong>Looking for more support options near you?</strong>
      <p >Many of these listings are provided through the Cancer Society of New Zealand, which works across Aotearoa to connect people and whānau facing cancer with compassionate, community-based care and services.</p>
      <p class="mt-7">
        🔗 Explore more support groups at <a href="https://www.cancer.org.nz/">cancer.org.nz</a>
      </p>
    </div>
  </div>
</Layout>