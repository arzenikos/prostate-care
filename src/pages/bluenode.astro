---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Canvas from '@components/astro/media/Canvas.astro';

const title = "Blue Node";
interface CanvasNode {
    id: string;
    title: string;
    excerpt: string;
    url: string;
    x: number;
    y: number;
    type: 'core' | 'content' | 'utility';
}

const [patients, family, researchers] = await Promise.all([
    getCollection('patient', ({ data }) => !data.draft),
    getCollection('family', ({ data }) => !data.draft),
    getCollection('researchers', ({ data }) => !data.draft),
]);

const branches = [
    {
        id: 'patient',
        title: 'Patient Support',
        excerpt: 'Information for people navigating a diagnosis',
        url: '/patient-space',
        articles: patients,
        articleUrl: (id: string) => `/patient-space/${id}`,
    },
    {
        id: 'family',
        title: 'Whānau Support',
        excerpt: 'Guidance for supporting someone you love',
        url: '/family-support',
        articles: family,
        articleUrl: (id: string) => `/family-support/${id}`,
    },
    {
        id: 'research',
        title: 'Research & Students',
        excerpt: 'Clinical and academic prostate cancer knowledge',
        url: '/researcher-hub',
        articles: researchers,
        articleUrl: (id: string) => `/researcher-hub/${id}`,
    },
] as const;

const nodes: CanvasNode[] = [
    {
        id: 'home',
        title: 'Home',
        excerpt: 'Pamana prostate cancer support',
        url: '/',
        x: 1000,
        y: 80,
        type: 'core',
    },
];
const edges: [string, string][] = [];

const branchX = [600, 1400, 1640];
const articleStartY = 700;
const articleGapY = 160;
const categoryStartX = 0;
const categoryGapX = 240;

const patientCategories = [
    {
        id: 'stage-0',
        title: 'Prostate cancer basics, tests, recurrence, & support',
        excerpt: 'Foundations, risk, testing, and support',
    },
    {
        id: 'stage-1',
        title: 'Stage 1',
        excerpt: 'Early-stage and localised options',
    },
    {
        id: 'stage-2',
        title: 'Stage 2',
        excerpt: 'Intermediate-risk prostate cancer',
    },
    {
        id: 'stage-3',
        title: 'Stage 3',
        excerpt: 'Locally advanced prostate cancer',
    },
    {
        id: 'stage-4',
        title: 'Stage 4',
        excerpt: 'Living well with advanced prostate cancer',
    },
] as const;

branches.forEach((branch, branchIndex) => {
    nodes.push({
        id: branch.id,
        title: branch.title,
        excerpt: branch.excerpt,
        url: branch.url,
        x: branchX[branchIndex],
        y: 280,
        type: 'core',
    });
    edges.push(['home', branch.id]);

    if (branch.id === 'patient') {
        patientCategories.forEach((category, categoryIndex) => {
            const categoryNodeId = `${branch.id}-${category.id}`;
            nodes.push({
                id: categoryNodeId,
                title: category.title,
                excerpt: category.excerpt,
                url: `/patient-space?stage=${category.id}`,
                x: categoryStartX + categoryIndex * categoryGapX,
                y: 460,
                type: 'core',
            });
            edges.push([branch.id, categoryNodeId]);

            branch.articles
                .filter((article) => {
                    const stage = article.data.stage ?? article.id.split('/')[0];
                    return stage === category.id;
                })
                .sort((a, b) => a.data.title.localeCompare(b.data.title))
                .forEach((article, articleIndex) => {
                    const id = `${categoryNodeId}-${article.id.replaceAll('/', '-')}`;
                    nodes.push({
                        id,
                        title: article.data.title,
                        excerpt: article.data.description,
                        url: `/patient-space/${article.id}`,
                        x: categoryStartX + categoryIndex * categoryGapX,
                        y: articleStartY + articleIndex * articleGapY,
                        type: 'content',
                    });
                    edges.push([categoryNodeId, id]);
                });
        });
        return;
    }

    branch.articles
        .sort((a, b) => a.data.title.localeCompare(b.data.title))
        .forEach((article, articleIndex) => {
            const id = `${branch.id}-${article.id.replaceAll('/', '-')}`;
            nodes.push({
                id,
                title: article.data.title,
                excerpt: article.data.description,
                url: branch.articleUrl(article.id),
                x: branchX[branchIndex],
                y: articleStartY + articleIndex * articleGapY,
                type: 'content',
            });
            edges.push([branch.id, id]);
        });
});

---
<Layout title={title}>

    <Canvas nodes={nodes} edges={edges} currentPath={Astro.url.pathname} height="100vh" />

</Layout>
