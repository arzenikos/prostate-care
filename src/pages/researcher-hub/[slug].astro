---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';

const paper = Astro.props.paper ?? (Astro.params.slug
  ? await getEntry('researchers', Astro.params.slug)
  : undefined);
if (!paper) {
  return Astro.redirect('/researcher-hub', 404);
}
const { Content } = await render(paper);
const heading = paper.data.heading ?? paper.data.title;
---

<ArticleLayout
  title={`Pamana | ${paper.data.title}`}
  heading={heading}
  hub="research"
  illustration={paper.data.illustration}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Research & Student Hub', href: '/researcher-hub' },
    { label: heading },
  ]}
>
  <Content />
</ArticleLayout>