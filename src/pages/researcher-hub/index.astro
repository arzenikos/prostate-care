---
import Layout from '@layouts/Layout.astro';
import HubHero from '@components/astro/hero/HubHero.astro';
import PlaceholderMedia from '@components/astro/media/PlaceholderMedia.astro';
import { hubs } from '@contents/ui/site';
import { getPdfJournalEntries } from '../../lib/research/pdfJournal';

const copy = hubs.research;
const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const pageData = await getPdfJournalEntries(Number.isFinite(requestedPage) ? requestedPage : 1, 10);
const { entries } = pageData;
const pageUrl = (page: number) => `/researcher-hub?page=${page}`;
---

<Layout title="Research Knowledge Hub" hub="research">
  <HubHero
    breadcrumbs={copy.breadcrumbs}
    heading={copy.heading}
    intro={copy.intro}
    illustration={copy.illustration}
    band={true}
    cta={{ label: copy.cta, href: copy.ctaHref }}
  />
  <section class="research">
    <div class="stats">
      <div class="stats__head">
        <h2>Statistics</h2>
        <label class="filter">
          Filter
          <input type="checkbox" name="filter" />
          <span>Off</span>
        </label>
      </div>
      <PlaceholderMedia label="Placeholder: statistics chart" />
      <p class="caption">Short stats summary.</p>
    </div>
    <div class="feed">
      <p class="latest">Journal library · {pageData.totalEntries} resources</p>
      {entries.map((entry) => (
        <article class="journal-entry">
          <div class="feed__title">
            <h3><a href={entry.pdfUrl} target="_blank" rel="noopener noreferrer">{entry.title}</a></h3>
          </div>
          <p class="meta">{entry.date} · {entry.author} · {entry.journal}</p>
          <p class="desc">{entry.description}</p>
          <p class="tags">{entry.tags.length ? entry.tags.join(' · ').toUpperCase() : 'RESEARCH'}</p>
        </article>
      ))}
      <nav class="pagination" aria-label="Research article pages">
        <a
          class:list={{ disabled: pageData.page === 1 }}
          href={pageUrl(Math.max(1, pageData.page - 1))}
          aria-disabled={pageData.page === 1}
        >Previous</a>
        {Array.from({ length: pageData.totalPages }, (_, index) => index + 1).map((page) => (
          <a
            class:list={{ active: page === pageData.page }}
            href={pageUrl(page)}
            aria-current={page === pageData.page ? 'page' : undefined}
          >{page}</a>
        ))}
        <a
          class:list={{ disabled: pageData.page === pageData.totalPages }}
          href={pageUrl(Math.min(pageData.totalPages, pageData.page + 1))}
          aria-disabled={pageData.page === pageData.totalPages}
        >Next</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .research {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    padding: 0.5rem 1.5rem 4rem;
  }

  .stats__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  h2,
  h3 {
    margin: 0;
    color: var(--color-navy);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .caption,
  .desc {
    font-style: italic;
    color: var(--color-navy);
  }

  .latest {
    margin: 0 0 0.6rem;
    color: #7b86c9;
    font-style: italic;
  }

  .feed__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .feed a {
    text-decoration: none;
  }

  .meta,
  .tags {
    color: var(--color-navy);
    font-size: 0.92rem;
  }

  .tags {
    text-align: right;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .journal-entry {
    padding: 0 0 1rem;
    margin-bottom: 1rem;
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .pagination a {
    min-width: 2.25rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    color: var(--color-navy);
    text-align: center;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .pagination a:hover,
  .pagination a:focus-visible,
  .pagination a.active {
    background: var(--color-navy);
    color: var(--color-surface);
  }

  .pagination a.disabled {
    opacity: 0.45;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .research {
      grid-template-columns: 1fr;
    }
  }
</style>
