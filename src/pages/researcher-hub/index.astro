---
import Layout from '@layouts/Layout.astro';
import HubHero from '@components/astro/hero/HubHero.astro';
import LineIcon from '@components/astro/ui/LineIcon.astro';
import PlaceholderMedia from '@components/astro/media/PlaceholderMedia.astro';
import { hubs } from '@contents/ui/site';
import { researchFeed } from '@contents/ui/article-paths';

const copy = hubs.research;
---

<Layout title="Research Knowledge Hub" hub="research">
  <HubHero
    breadcrumbs={copy.breadcrumbs}
    heading={copy.heading}
    intro={copy.intro}
    illustration={copy.illustration}
    band={true}
    cta={{ label: copy.cta, href: copy.ctaHref }}
  />
  <section class="research">
    <div class="stats">
      <div class="stats__head">
        <h2>Statistics</h2>
        <label class="filter">
          Filter
          <input type="checkbox" name="filter" />
          <span>Off</span>
        </label>
      </div>
      <PlaceholderMedia label="Placeholder: statistics chart" />
      <p class="caption">Short stats summary.</p>
    </div>
    <div class="feed">
      <p class="latest">Latest</p>
      <article>
        <div class="feed__title">
          <h3>

            <a href=`researcher-hub/${researchFeed.href}`>
              {researchFeed.title}
            </a>
          </h3>
          <LineIcon name="bookmark" />
        </div>
        <p class="meta">{researchFeed.date} • {researchFeed.author} • {researchFeed.affiliation}</p>
        <p class="desc">{researchFeed.description}</p>
        <p class="tags">{researchFeed.tags.join(' | ').toUpperCase()}</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .research {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    padding: 0.5rem 1.5rem 4rem;
  }

  .stats__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  h2,
  h3 {
    margin: 0;
    color: var(--color-navy);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .caption,
  .desc {
    font-style: italic;
    color: var(--color-navy);
  }

  .latest {
    margin: 0 0 0.6rem;
    color: #7b86c9;
    font-style: italic;
  }

  .feed__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .feed a {
    text-decoration: none;
  }

  .meta,
  .tags {
    color: var(--color-navy);
    font-size: 0.92rem;
  }

  .tags {
    text-align: right;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  @media (max-width: 860px) {
    .research {
      grid-template-columns: 1fr;
    }
  }
</style>
