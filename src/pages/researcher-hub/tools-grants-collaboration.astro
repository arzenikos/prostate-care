---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
import { content } from '@contents/users/c-researcher-content.ts';

const heading = content['researcher'].heading3.title;
const main = content['researcher'].heading3.main;
---

<SimpleArticle
  title={`Pamana | ${heading}`}
  heading={heading}
  hub="research"
  parentLabel="Looking for academic and clinical research"
  parentHref="/researcher"
>
  <h2>{main.x.subheading}</h2>
  <p>{main.x.body[0]}</p>
</SimpleArticle>
