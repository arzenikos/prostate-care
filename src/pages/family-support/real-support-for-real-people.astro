---
import SimpleArticle from '@components/astro/article/SimpleArticle.astro';
import { content } from '@contents/users/c-caregiver-content.ts';

const heading = content['caregiver'].heading3.title;
const main = content['caregiver'].heading3.main;
---

<SimpleArticle
  title={`Pamana | ${heading}`}
  heading={heading}
  hub="whanau"
  parentLabel="Supporting a loved one"
  parentHref="/caregiver"
>
  <h2>{main.x.subheading}</h2>
  <p>{main.x.body[0]}</p>
</SimpleArticle>
