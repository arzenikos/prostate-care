---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';

const article = Astro.params.slug
  ? await getEntry('family', Astro.params.slug)
  : undefined;
if (!article || article.data.draft) {
  return Astro.redirect('/family-support', 404);
}
const { Content } = await render(article);
const heading = article.data.heading ?? article.data.title;
---

<ArticleLayout
  title={`${article.data.title}`}
  heading={heading}
  hub="whanau"
  illustration={article.data.illustration}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Supporting a loved one', href: '/family-support' },
    { label: heading },
  ]}
>
  <Content />
</ArticleLayout>