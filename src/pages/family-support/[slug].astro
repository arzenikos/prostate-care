---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('family', ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'family'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const heading = article.data.heading ?? article.data.title;
---

<ArticleLayout
  title={`Pamana | ${article.data.title}`}
  heading={heading}
  hub="whanau"
  illustration={article.data.illustration}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Supporting a loved one', href: '/family-support' },
    { label: heading },
  ]}
>
  <Content />
</ArticleLayout>
