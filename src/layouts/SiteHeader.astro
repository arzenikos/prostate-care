---
import BrandMark from '@components/astro/brand/BrandMark.astro';
import UtilityNav from '@components/astro/chrome/UtilityNav.astro';
import type { HubId } from '@contents/ui/site';
import { hubs } from '@contents/ui/site';

interface Props {
  variant?: 'landing' | 'hub' | 'minimal';
  hub?: HubId;
}

const { variant = 'hub', hub = 'patient' } = Astro.props;
const hubCopy = hubs[hub];
---

<header class:list={['site-header', `site-header--${variant}`]}>
  <div class="site-header__inner">
    <div class="site-header__brand-container">
      {variant === 'hub' ? (
        <a class="site-header__brand" href="/">
          <BrandMark size="lg" />

          <span>
            <strong>{hubCopy.kicker}</strong>
            <em>{hubCopy.subtitle}</em>
          </span>
        </a>
      ) : (
        <span></span>
      )}
    </div>
    <UtilityNav />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* max-width: var(--content-width); */
    margin: 0 auto;
    padding: 1.25rem 1.5rem 0.75rem;
    min-height: var(--header-height);
    box-sizing: border-box;
  }

  .site-header--landing .site-header__inner {
    justify-content: flex-end;
  }

  .site-header__brand-container {
    display: flex;
    align-items: center;
    justify-content: left;
    gap: 1rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: var(--color-navy);
  }

  strong {
    display: block;
    font-size: 1.65rem;
    letter-spacing: 0.04em;
  }

  em {
    display: block;
    font-style: normal;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-blue);
  }
</style>
