---
import SiteHeader from '@layouts/SiteHeader.astro';
import SiteFooter from '@layouts/SiteFooter.astro';
import HubOverlay from '@components/astro/chrome/HubOverlay.astro';
import ChatWidget  from '@components/react/ChatWidget';
import PrometheusChat from '@components/astro/chrome/PrometheusChat.astro';
import type { HubId } from '@contents/ui/site';
import '@styles/globals.css';
                

interface Props {
  title: string;
  description?: string;
  variant?: 'landing' | 'hub' | 'minimal';
  hub?: HubId;
  showChat?: boolean;
}

const {
  title,
  description = 'Pamana — prostate cancer support for Aotearoa New Zealand',
  variant = 'hub',
  hub = 'patient',
  showChat = true,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link href="https://fonts.cdnfonts.com/css/maragsa" rel="stylesheet">

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>
      {title}</title>
      <link rel="icon" type="image/png" href="/assets/images/logo/pamana-logo.png"/>
  </head>
  <body>
    <SiteHeader variant={variant} hub={hub} />
    <PrometheusChat client:load />
    
    <HubOverlay />

    <main>
      <slot />
    </main>
    <!-- <ChatWidget client:load /> -->
    <SiteFooter />
  </body>
</html>

<style is:global>
  main {
    min-height: calc(100vh - 160px);
  }
</style>
