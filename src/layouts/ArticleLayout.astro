---
import Layout from './Layout.astro';
import Breadcrumbs from '@components/astro/ui/Breadcrumbs.astro';
import LineIcon from '@components/astro/ui/LineIcon.astro';
import PlaceholderMedia from '@components/astro/media/PlaceholderMedia.astro';
import type { HubId } from '@contents/ui/site';
import type { Crumb } from '../lib/types/nav';

interface Props {
  title: string;
  heading: string;
  breadcrumbs: Crumb[];
  hub?: HubId;
  illustration?: string;
  toc?: { id: string; label: string }[];
}

const {
  title,
  heading,
  breadcrumbs,
  hub = 'patient',
  illustration = 'Placeholder: article illustration',
  toc = [],
} = Astro.props;
---

<Layout title={title} hub={hub}>
  <article class:list={['article', hub === 'patient' && 'article--patient']}>
    <header class="article__hero">
      <div>
        <Breadcrumbs items={breadcrumbs} />
        <div class="article__title-row">
          <h1>{heading}</h1>
          <button type="button" class="share" aria-label="Share this page">
            <LineIcon name="share" />
          </button>
        </div>
      </div>
      <PlaceholderMedia label={illustration} />
    </header>

    <div class="article__grid">
      <aside>
        <p>On this page</p>
        {toc.length > 0 ? (
          <nav aria-label="On this page">
            {toc.map((item) => (
              <a href={`#${item.id}`}>{item.label}</a>
            ))}
          </nav>
        ) : (
          <p class="empty-toc">Article sections will appear here.</p>
        )}
      </aside>
      <div class="article__body">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .article {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0.5rem 1.5rem 4rem;
  }

  .article--patient {
    --article-reading-width: 760px;
    --article-accent: var(--color-blue);
    --article-heading: var(--color-navy-deep);
    --article-copy: #3f4858;
  }

  .article--patient .article__hero {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1.75rem 0 2.25rem;
    border-bottom: 0;
  }

  .article--patient .article__hero > div:first-child::before {
    content: 'PATIENT SUPPORT';
    display: block;
    margin: 1.25rem 0 0.7rem;
    color: var(--article-accent);
    font-family: var(--font-gotham);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .article__hero {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 1.5rem;
    align-items: start;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article__title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    color: var(--color-navy);
  }

  .article--patient h1 {
    max-width: 720px;
    margin-top: 0.4rem;
    color: var(--article-heading);
    font-family: var(--font-gotham);
    font-size: clamp(2.35rem, 5vw, 4.25rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .share {
    margin-top: 1.1rem;
    border: 0;
    background: transparent;
    color: var(--color-navy);
    cursor: pointer;
  }

  .article__grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  .article--patient .article__grid {
    max-width: 1040px;
    margin: 0 auto;
    grid-template-columns: 190px minmax(0, var(--article-reading-width));
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  aside {
    border-right: 1px solid var(--color-border);
    padding-right: 1rem;
  }

  aside p {
    margin: 0 0 0.8rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  aside a {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  aside a:hover {
    color: var(--color-navy);
  }

  .article--patient aside {
    position: sticky;
    top: 1.5rem;
    align-self: start;
    border-right: 0;
    border-left: 3px solid var(--article-accent);
    padding: 0.15rem 0 0.15rem 1rem;
  }

  .article--patient aside p:first-child {
    margin-bottom: 1rem;
    font-family: var(--font-gotham);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .article--patient aside a {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .article__body :global(h2) {
    margin: 0 0 0.8rem;
    color: var(--color-navy);
  }

  .article--patient .article__body {
    max-width: var(--article-reading-width);
    padding-bottom: 2rem;
  }

  .article--patient .article__body :global(h2) {
    margin: 3rem 0 0.9rem;
    color: var(--article-heading);
    font-family: var(--font-gotham);
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .article--patient .article__body :global(h2:first-child) {
    margin-top: 0;
  }

  .article__body :global(p),
  .article__body :global(li) {
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .article--patient .article__body :global(p),
  .article--patient .article__body :global(li) {
    color: var(--article-copy);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .article--patient .article__body :global(p:first-of-type) {
    color: var(--color-navy-soft);
    font-size: 1.16rem;
    line-height: 1.7;
  }

  .article--patient .article__body :global(h3) {
    margin: 2rem 0 0.65rem;
    color: var(--article-heading);
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .article--patient .article__body :global(ul),
  .article--patient .article__body :global(ol) {
    margin: 1rem 0 1.5rem;
    padding-left: 1.4rem;
  }

  .article--patient .article__body :global(li) {
    padding-left: 0.35rem;
    margin-bottom: 0.45rem;
  }

  .article--patient .article__body :global(a) {
    color: var(--article-accent);
    font-weight: 650;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .article__body :global(h3) {
    margin: 1.4rem 0 0.5rem;
    color: var(--color-navy);
  }

  .article__body :global(blockquote) {
    margin: 0 0 1.4rem;
    padding: 1rem 1.1rem;
    border-left: 4px solid var(--color-navy);
    background: var(--color-card);
  }

  .article--patient .article__body :global(blockquote) {
    margin: 2rem 0;
    border-left: 0;
    border-top: 4px solid var(--article-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-card);
    color: var(--color-navy-deep);
    font-size: 1.05rem;
  }

  .article__body :global(.media-placeholder) {
    display: grid;
    place-items: center;
    min-height: 140px;
    margin: 0.8rem 0 1.2rem;
    padding: 1rem;
    border: 1px dashed var(--color-border);
    background: repeating-linear-gradient(
      45deg,
      #f4f4f4,
      #f4f4f4 8px,
      #ececec 8px,
      #ececec 16px
    );
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .empty-toc {
    font-weight: 400;
    color: var(--color-text-subtle);
  }

  @media (max-width: 860px) {
    .article__hero,
    .article__grid {
      grid-template-columns: 1fr;
    }

    aside {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 1rem;
    }

    .article--patient .article__hero {
      padding-top: 0.75rem;
    }

    .article--patient .article__grid {
      gap: 1.5rem;
    }

    .article--patient aside {
      position: static;
      border-left: 0;
      border-bottom: 1px solid var(--color-border);
      padding: 0 0 1rem;
    }
  }
</style>
