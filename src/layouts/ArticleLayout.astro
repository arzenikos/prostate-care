---
import Layout from './Layout.astro';
import Breadcrumbs from '@components/astro/ui/Breadcrumbs.astro';
import LineIcon from '@components/astro/ui/LineIcon.astro';
import PlaceholderMedia from '@components/astro/media/PlaceholderMedia.astro';
import type { HubId } from '@contents/ui/site';
import type { Crumb } from '../lib/types/nav';

interface Props {
  title: string;
  heading: string;
  breadcrumbs: Crumb[];
  hub?: HubId;
  illustration?: string;
  toc?: { id: string; label: string }[];
}

const {
  title,
  heading,
  breadcrumbs,
  hub = 'patient',
  illustration = 'Placeholder: article illustration',
  toc = [],
} = Astro.props;
---

<Layout title={title} hub={hub}>
  <article class="article">
    <header class="article__hero">
      <div>
        <Breadcrumbs items={breadcrumbs} />
        <div class="article__title-row">
          <h1>{heading}</h1>
          <button type="button" class="share" aria-label="Share this page">
            <LineIcon name="share" />
          </button>
        </div>
      </div>
      <PlaceholderMedia label={illustration} />
    </header>

    <div class="article__grid">
      <aside>
        <p>On this page</p>
        {toc.length > 0 ? (
          <nav aria-label="On this page">
            {toc.map((item) => (
              <a href={`#${item.id}`}>{item.label}</a>
            ))}
          </nav>
        ) : (
          <p class="empty-toc">Article sections will appear here.</p>
        )}
      </aside>
      <div class="article__body">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .article {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0.5rem 1.5rem 4rem;
  }

  .article__hero {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 1.5rem;
    align-items: start;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article__title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    color: var(--color-navy);
  }

  .share {
    margin-top: 1.1rem;
    border: 0;
    background: transparent;
    color: var(--color-navy);
    cursor: pointer;
  }

  .article__grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  aside {
    border-right: 1px solid var(--color-border);
    padding-right: 1rem;
  }

  aside p {
    margin: 0 0 0.8rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  aside a {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  aside a:hover {
    color: var(--color-navy);
  }

  .article__body :global(h2) {
    margin: 0 0 0.8rem;
    color: var(--color-navy);
  }

  .article__body :global(p),
  .article__body :global(li) {
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .article__body :global(h3) {
    margin: 1.4rem 0 0.5rem;
    color: var(--color-navy);
  }

  .article__body :global(blockquote) {
    margin: 0 0 1.4rem;
    padding: 1rem 1.1rem;
    border-left: 4px solid var(--color-navy);
    background: var(--color-card);
  }

  .article__body :global(.media-placeholder) {
    display: grid;
    place-items: center;
    min-height: 140px;
    margin: 0.8rem 0 1.2rem;
    padding: 1rem;
    border: 1px dashed var(--color-border);
    background: repeating-linear-gradient(
      45deg,
      #f4f4f4,
      #f4f4f4 8px,
      #ececec 8px,
      #ececec 16px
    );
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .empty-toc {
    font-weight: 400;
    color: var(--color-text-subtle);
  }

  @media (max-width: 860px) {
    .article__hero,
    .article__grid {
      grid-template-columns: 1fr;
    }

    aside {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 1rem;
    }
  }
</style>
